{
  "name": "XML",
  "scopeName": "text.xml",
  "fileTypes": ["xml"],
  "patterns": [
    { "name": "comment.block.xml", "begin": "<!--", "end": "-->" },
    { "name": "meta.tag.preprocessor.xml", "begin": "<\\?", "end": "\\?>",
      "patterns": [ { "include": "#attribute" }, { "include": "#string" } ] },
    { "name": "string.unquoted.cdata.xml", "begin": "<!\\[CDATA\\[", "end": "\\]\\]>" },
    { "begin": "(</?)([\\w:.\\-]+)", "end": "(/?>)",
      "beginCaptures": { "1": { "name": "punctuation.definition.tag.xml" }, "2": { "name": "entity.name.tag.xml" } },
      "endCaptures": { "1": { "name": "punctuation.definition.tag.xml" } },
      "patterns": [ { "include": "#attribute" }, { "include": "#string" } ] },
    { "name": "constant.other.reference.xml", "match": "[@?][\\w:+.]*/[\\w.$]+" },
    { "name": "constant.character.entity.xml", "match": "&[\\w#]+;" }
  ],
  "repository": {
    "attribute": {
      "match": "\\b(?:([\\w\\-]+)(:))?([\\w\\-.]+)\\s*(=)",
      "captures": {
        "1": { "name": "entity.other.attribute-name.namespace.xml" },
        "2": { "name": "punctuation.separator.namespace.xml" },
        "3": { "name": "entity.other.attribute-name.xml" },
        "4": { "name": "punctuation.separator.key-value.xml" }
      }
    },
    "string": {
      "name": "string.quoted.double.xml", "begin": "\"", "end": "\"",
      "patterns": [
        { "name": "constant.other.reference.xml", "match": "[@?]\\+?[\\w:.]*/[\\w.$]+" },
        { "name": "constant.character.entity.xml", "match": "&[\\w#]+;" }
      ]
    }
  }
}
